{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The swagger plugin needs a type checker, which isolated transpilation skips.
    // ts-jest warns (TS151002) about nodenext without isolatedModules, but still
    // emits CommonJS here, so jest-e2e.json silences that code.
    "isolatedModules": false
  }
}
