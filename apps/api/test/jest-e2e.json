{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.e2e.json",
        "diagnostics": { "ignoreCodes": [151002] },
        "astTransformers": {
          "before": [
            { "path": "<rootDir>/swagger-plugin-transformer.js" }
          ]
        }
      }
    ]
  },
  "transformIgnorePatterns": ["/node_modules/(?!(\\.pnpm|@scalar)/)"]
}
