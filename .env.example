# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# `.env` is git-ignored. docker-compose reads it automatically for variable
# substitution (e.g. JWT_SECRET below).

# Postgres connection string.
# - For the API running INSIDE docker-compose, compose overrides this with the
#   `postgres` service host, so you don't need to set it for Docker.
# - For running the API NATIVELY (pnpm --filter api start:dev) against the
#   compose database, use localhost:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_flow

# Production only (Render), never in a local .env: Neon's DIRECT connection
# string, used just for `prisma migrate deploy` by the container's start
# script, while DATABASE_URL is Neon's pooled string. See docs/deploy.md.
# DATABASE_URL_UNPOOLED=

# Secret used to sign/verify JWT auth tokens. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Optional — comma-separated list of web origins allowed to call the API from a
# browser (CORS). Defaults to the local Next.js dev server. In production, set it
# to the web app's URL, e.g. https://money-flow-web.vercel.app
# CORS_ORIGINS=http://localhost:3000

# Optional — API port (defaults to 3001).
# PORT=3001

# Optional — serve the API docs at /api/docs even when NODE_ENV=production
# (they are always on in development).
# API_DOCS=true
